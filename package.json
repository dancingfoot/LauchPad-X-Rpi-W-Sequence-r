{
  "name": "launchpad-x-sequencer",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone 8-track polyphonic MIDI step sequencer for Novation Launchpad X and Raspberry Pi Zero W",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release-dist",
    "lint": "tsc --noEmit",
    "build:appimage": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "build": {
    "appId": "com.novation.launchpadx.sequencer",
    "productName": "Launchpad X Sequencer",
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "maintainer": "Novation Launchpad X Community",
      "synopsis": "Interactive Launchpad X MIDI step sequencer and Web Audio workstation",
      "desktop": {
        "Name": "Launchpad X Sequencer",
        "Comment": "Novation Launchpad X MIDI Sequencer",
        "Categories": "AudioVideo;Audio;Midi;"
      }
    }
  }
}
